{
  "expo": {
    "name": "Anagkazo",
    "slug": "anagkazo-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/anagkazo-logo.png",
    "scheme": "churchapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.churchapp.anagkazo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.churchapp.anagkazo",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/anagkazo-logo.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/anagkazo-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store",
      "expo-notifications"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/anagkazo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e15a058b-f064-4799-9991-bafb3517eb36"
      }
    }
  }
}
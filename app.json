{
  "expo": {
    "scheme": "churchapp",
    "name": "Anagkazo",
    "slug": "anagkazo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/anagkazo-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/anagkazo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.churchapp.anagkazo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.churchapp.anagkazo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/anagkazo-logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/anagkazo-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e15a058b-f064-4799-9991-bafb3517eb36"
      }
    }
  }
}
